# Python bytecode from running the integration or its tests locally.
__pycache__/
*.pyc

# Shared block (HYG-6), from winui-app-kit build/shared.gitignore. Paste it unchanged as the last part
# of every repo's .gitignore, so no earlier line can un-ignore what it covers. Change it in the kit.
/.artifacts/
/.windows-build/
/.worktrees/
.secrets/
.aws/
.env
.env.*
!.env*.example
tmp/
.backups/
*.pfx
*.cer
*.der
*.keystore
*.jks
local.properties
.vs/
.idea/
.DS_Store
Thumbs.db
